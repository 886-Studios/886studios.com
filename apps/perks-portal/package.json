{
  "name": "886-portfolio-perks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4 <23", "npm": ">=9.6.5" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "validate": "npm test && npm run build",
    "preflight": "node --env-file-if-exists=.env.local scripts/preflight.mjs",
    "validate:release": "npm run preflight && npm run validate"
  }
}
