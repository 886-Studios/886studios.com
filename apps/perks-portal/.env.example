# Generate at least 16 random characters (maximum 256); no surrounding whitespace.
# Share the code only with approved portfolio companies.
PERKS_ACCESS_CODE=
# Generate at least 32 random bytes, encoded as base64url (43+ characters) or hex.
# Never share the session secret. Credentials must differ; placeholders are rejected.
PERKS_SESSION_SECRET=
APP_ORIGIN=https://www.886studios.com
APP_BASE_PATH=/perks
PORT=4186
# Server/staff only. Never use a public-prefixed variable for the partner key.
# Staging generates non-redeemable test codes. Production must be explicit.
SUPABASE_PARTNER_ENVIRONMENT=staging
SUPABASE_PARTNER_API_KEY=
# Separate 32+ random bytes encoded as base64url. Staff and server must share it.
# Rotation invalidates outstanding claim links; never distribute this secret.
SUPABASE_CLAIM_SECRET=
# Staff-only login; different from the founder access code and session secret.
PERKS_ADMIN_ACCESS_CODE=
PERKS_ADMIN_SESSION_SECRET=
# Durable approved-email list and request throttling; required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Transactional claim emails. PERKS_EMAIL_FROM must be a Resend-verified sender.
RESEND_API_KEY=
PERKS_EMAIL_FROM=
