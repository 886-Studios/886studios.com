---
import initializationScript from "../scripts/google-analytics.js?url";

interface Props {
  measurementId?: string;
}

const { measurementId } = Astro.props;
---

{
  measurementId && (
    <>
      <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-NC2CNQ3T"></script>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}></script>
      <script is:inline src={initializationScript} data-google-analytics-id={measurementId}></script>
    </>
  )
}
