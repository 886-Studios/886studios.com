---
interface Props {
  name: string;
  photo: string;
  eager?: boolean;
  profile?: boolean;
}
const { name, photo, eager = false, profile = false } = Astro.props;
const cutout = photo.replace("/headshots/", "/headshots/team/");
const directoryCutouts: Record<string, string> = {
  "/assets/headshots/team/james-hong-portrait.webp": "/assets/headshots/team/james-hong-portrait-400.webp",
  "/assets/headshots/team/patryk-chojecki.webp": "/assets/headshots/team/patryk-chojecki-400.webp",
};
const portraitSrc = profile ? cutout : (directoryCutouts[cutout] ?? cutout);
// Share the exact framing and silhouette between the directory and profiles.
const portraits: Record<string, [number, number, number, number]> = {
  "Kai Huang": [1.2, 0, -17, 0],
  "Kevin Lin": [1.08, 0, -8, 1],
  "Max Hsieh": [1.3, -2, -17, 2],
  "Patryk Chojecki": [1.05, 0, -3, 3],
  "Carter Wang": [1.06, 0, -4, 0],
  "Kevin Chou": [1, 0, 0, 0],
  "Chris Wang": [1, 0, 0, 1],
  "Phil Chen": [1.7, -3, -12, 2],
  "Jameson Hsu": [1, 0, 0, 3],
  "Joseph Hei": [1.08, -5, -7, 0],
  "Jacob Hsu": [1.13, 0, -11, 1],
  "Charles Huang": [1.65, -25, -16, 2],
  "James Hong": [1.25, 0, -4, 3],
  "Steven Chiang": [1, 0, 0, 0],
  "Timothy Chen": [1.06, 0, -3, 1],
};
const [scale, x, y, variant] = portraits[name] ?? [1, 0, 0, 0];
const sharpen = ["Kevin Chou", "Charles Huang"].includes(name);
const filterId = `portrait-sharpen-${name.toLowerCase().replaceAll(" ", "-")}`;
---

<div class:list={["portrait", `portrait--${variant}`, profile && "portrait--profile"]}>
  {sharpen && (
    <svg class="portrait-filter" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <filter id={filterId} color-interpolation-filters="sRGB">
          <!-- A mild, deterministic edge-sharpening kernel; no new image detail. -->
          <feConvolveMatrix order="3" kernelMatrix="0 -0.2 0 -0.2 1.8 -0.2 0 -0.2 0" preserveAlpha="true" />
        </filter>
      </defs>
    </svg>
  )}
  <span class="portrait-shape" aria-hidden="true"></span>
  <img
    class:list={{ "portrait-trim-edge": name === "Joseph Hei" }}
    src={portraitSrc}
    alt={name}
    width="400"
    height="400"
    loading={eager ? "eager" : "lazy"}
    fetchpriority={profile ? "high" : undefined}
    decoding="async"
    style={`--portrait-scale: ${scale}; --portrait-x: ${x}%; --portrait-y: ${y}%; --portrait-sharpen: ${sharpen ? `url(#${filterId})` : "brightness(1)"}`}
  />
</div>

<style>
  .portrait {
    position: relative;
    isolation: isolate;
    width: min(100%, 200px);
    aspect-ratio: 1;
    margin: 0 auto var(--space-xs);
    overflow: hidden;
    border-radius: 0 0 24% 24%;
  }
  .portrait--profile { width: 100%; margin: 0; }
  .portrait-filter { position: absolute; pointer-events: none; }
  .portrait-shape {
    position: absolute;
    z-index: -1;
    inset: 13% 2% 0;
    background: var(--purple);
    mask: url("/assets/team/portrait-shape-mask.svg") center / 100% 100% no-repeat;
    mask-mode: luminance;
    /* The link engages the backdrop; the photograph keeps its exact framing. */
    rotate: calc(var(--portrait-engaged, 0) * var(--portrait-turn, 5deg));
    transition: rotate 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .portrait--1, .portrait--3 { --portrait-turn: -5deg; }
  .portrait--1 .portrait-shape { transform: scaleX(-1); }
  .portrait--2 .portrait-shape { transform: rotate(-8deg) scale(.94); }
  .portrait--3 .portrait-shape { transform: rotate(7deg) scale(.94); }
  .portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter: grayscale(1) var(--portrait-sharpen);
    transform-origin: top center;
    transform: translate(var(--portrait-x), var(--portrait-y)) scale(var(--portrait-scale));
  }
  /* Joseph's source has a bright rightmost column; trim it and its sampling edge. */
  .portrait img.portrait-trim-edge { clip-path: inset(0 .5% 0 0); }
  @media (prefers-reduced-motion: reduce) {
    .portrait-shape { rotate: none; transition: none; }
  }
</style>
