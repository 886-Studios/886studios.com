---
import { siteContent } from "../data/siteContent";
import { partnerProfileByName } from "../data/partnerProfiles";
import TeamPerson from "./TeamPerson.astro";

const { about } = siteContent;
const operatingPartnerNames = new Set(["Kai Huang", "Kevin Lin"]);
const partners = about.partners.map((person) => partnerProfileByName.get(person.name)!);
const operatingTeam = about.team.map((person) => partnerProfileByName.get(person.name)!);
const groups = [
  { title: about.teamTitle, kind: "operating", people: [...partners.filter((person) => operatingPartnerNames.has(person.name)), ...operatingTeam] },
  { title: "Partners", kind: "partners", people: partners.filter((person) => !operatingPartnerNames.has(person.name)) },
];
---

<div class="people">
  {groups.map((group) => (
    <section class:list={["people-group", `people-group--${group.kind}`]} aria-labelledby={`people-${group.kind}`}>
      <h2 class="section-tag about-column-tag" id={`people-${group.kind}`}>{group.title}</h2>
      <ul class="people-grid" role="list">
        {group.people.map((person) => (
          <li>
            <TeamPerson
              name={person.name}
              photo={person.photo}
              role={person.role}
              company={person.company}
              profileHref={`/team/${person.slug}`}
              socials={person.socials}
              eager={group.kind === "operating"}
            />
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .people { display: grid; gap: var(--space-xl) var(--space-md); }
  .people-group { min-width: 0; }
  .people-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 var(--space-md);
    padding: 0;
    margin: 0 0 calc(-1 * var(--space-lg));
  }
  .people-grid > li {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 5;
    row-gap: 0;
    min-width: 0;
    padding-bottom: var(--space-lg);
  }
  @media (min-width: 1100px) {
    .people-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .people { row-gap: var(--space-lg); }
    .people-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-sm); }
    .people-grid { margin-bottom: calc(-1 * var(--space-md)); }
    .people-grid > li { padding-bottom: var(--space-md); }
  }
</style>
