---
import type { LumaEventCard } from "../lib/luma";

interface Props {
  event: LumaEventCard;
  tag: string;
  highlight?: boolean;
}

const { event, tag, highlight = false } = Astro.props;
const mediaClass = event.coverUrl ? "ev-media" : "ev-media ev-media--date-only";
const cardClass = `ev-card${event.url ? " ev-card--link" : ""}${highlight ? " ev-card--featured" : ""}`;
const isLearnMore = tag.toLowerCase() === "learn more";
const tagLabel = isLearnMore ? "Learn more" : tag;
---

{
  event.url ? (
    <a
      class={cardClass}
      href={event.url}
      target="_blank"
      rel="noopener noreferrer"
      data-analytics-event={isLearnMore ? "event_details_opened" : "event_registration_started"}
      data-analytics-placement="events_list"
      data-analytics-label={event.title}
    >
      <div class={mediaClass}>
        <time class="ev-date" datetime={event.startAt} aria-label={`${event.month} ${event.day}, ${event.year}`}>
          <div class="ev-month">{event.month}</div>
          <div class="ev-day">{event.day}</div>
          <div class="ev-year">{event.year}</div>
        </time>
        {event.coverUrl && (
          <img
            class="ev-thumb"
            src={event.coverUrl}
            alt=""
            width="96"
            height="96"
            loading={highlight ? "eager" : "lazy"}
            decoding="async"
            fetchpriority={highlight ? "high" : undefined}
          />
        )}
      </div>
      <div class="ev-copy">
        <div class="ev-title">{event.title}</div>
        <div class="ev-meta">{event.meta}</div>
      </div>
      <div class="ev-tag">
        <span>{tagLabel}</span>
        <span class="sr-only"> (opens in a new tab)</span>
      </div>
    </a>
  ) : (
    <div class={cardClass}>
      <div class={mediaClass}>
        <time class="ev-date" datetime={event.startAt} aria-label={`${event.month} ${event.day}, ${event.year}`}>
          <div class="ev-month">{event.month}</div>
          <div class="ev-day">{event.day}</div>
          <div class="ev-year">{event.year}</div>
        </time>
        {event.coverUrl && (
          <img
            class="ev-thumb"
            src={event.coverUrl}
            alt=""
            width="96"
            height="96"
            loading="lazy"
            decoding="async"
          />
        )}
      </div>
      <div class="ev-copy">
        <div class="ev-title">{event.title}</div>
        <div class="ev-meta">{event.meta}</div>
      </div>
      <div class="ev-tag">{tagLabel}</div>
    </div>
  )
}
