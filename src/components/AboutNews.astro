---
import { siteContent } from "../data/siteContent";

interface Props {
  spacious?: boolean;
}

const { spacious = false } = Astro.props;
const Headline = spacious ? "h2" : "h3";
const { resources } = siteContent;
const newsItems = spacious
  ? [...resources.newsItems].sort((a, b) => b.publishedAt.localeCompare(a.publishedAt))
  : resources.newsItems;
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const getNewsImageSrcset = (src: string) =>
  `${src.replace("-960.webp", "-480.webp")} 480w, ${src} 960w`;
---

<section class="about-news reveal reveal-delay-1" aria-labelledby={spacious ? undefined : "about-news-title"} aria-label={spacious ? "Press coverage" : undefined}>
  {!spacious && <h2 class="section-tag" id="about-news-title">In the News</h2>}

  <div class="about-news-grid">
    {newsItems.map((item) => (
      <article class="about-news-item">
        <a
          class="about-news-media"
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Read “${item.title}”`}
        >
          <img
            src={item.image.src}
            srcset={getNewsImageSrcset(item.image.src)}
            sizes={spacious
              ? "(max-width: 380px) 80px, (max-width: 720px) 96px, (max-width: 980px) 192px, 240px"
              : "(max-width: 720px) 104px, (max-width: 980px) 30vw, 208px"}
            alt={item.image.alt}
            width={item.image.width}
            height={item.image.height}
            loading="lazy"
            decoding="async"
          />
        </a>

        <div class="about-news-copy">
          <div class="about-news-meta">
            <p>{item.source}</p>
            {item.secondaryLink && (
              <a href={item.secondaryLink.href} target="_blank" rel="noopener noreferrer">
                {item.secondaryLink.label}
              </a>
            )}
            {spacious && (
              <time datetime={item.publishedAt}>
                {dateFormatter.format(new Date(`${item.publishedAt}T00:00:00Z`))}
              </time>
            )}
          </div>
          <Headline class="about-news-headline">
            <a href={item.href} target="_blank" rel="noopener noreferrer">
              <span>{item.title}</span>
            </a>
          </Headline>
        </div>
      </article>
    ))}
  </div>
</section>
