---
import { socialLinks } from "../data/siteContent";
import { socialIconPaths } from "../data/socialIcons";

interface Props {
  className?: string;
}

const { className = "socials" } = Astro.props;
---

<div class={className}>
  {
    socialLinks.map((link) => (
      <a
        class="social-btn"
        href={link.href}
        target={link.platform === "rss" ? undefined : "_blank"}
        rel={link.platform === "rss" ? undefined : "noopener noreferrer"}
        aria-label={link.ariaLabel}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d={socialIconPaths[link.platform]} />
        </svg>
      </a>
    ))
  }
</div>
