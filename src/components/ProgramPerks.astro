---
import { siteContent } from "../data/siteContent";

interface Props {
  id: string;
  program: string;
}

const { id, program } = Astro.props;
const { perks } = siteContent.resources;
---

<section class="program-perks res-perks" aria-labelledby={`${id}-heading`}>
  <header class="res-section-hdr">
    <div>
      <h2 class="section-h2 section-h2--compact" id={`${id}-heading`}>{perks.title}</h2>
      <p>Access partner perks through {program}.</p>
    </div>
  </header>

  <div class="res-perks-grid">
    {perks.categories.map((category, categoryIndex) => (
      <section
        class="res-perk-card"
        aria-labelledby={`${id}-category-${categoryIndex}`}
      >
        <h3 class="res-perk-label" id={`${id}-category-${categoryIndex}`}>
          {category.title}
        </h3>
        <ul class="res-perk-tools">
          {category.items.map((item) => (
            <li>
              <a
                class="res-perk-tool"
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="res-perk-logo">
                  <img src={item.logoSrc} alt="" width="64" height="64" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                </span>
                <span class="res-perk-name">{item.label}</span>
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</section>

<style>
.program-perks {
  --res-divider-space: 24px;
}

:global(.prog-body) > .program-perks {
  padding-block: var(--prog-section-half-gap);
  border-top: 1px solid var(--border);
}

.res-section-hdr {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: var(--res-divider-space);
}

.res-section-hdr h2 {
  margin-bottom: var(--space-xs);
  font-family: var(--font-display);
  font-size: clamp(22px, 2.8vw, 34px);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.1;
}

.res-section-hdr p {
  color: var(--text-secondary);
  font-size: 16px;
  line-height: 1.75;
}

/* ── Exclusive Perks ── */
.res-perks-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--res-divider-space) 32px;
}

.res-perk-card {
  min-width: 0;
  padding: var(--res-divider-space) 0 0;
  background: transparent;
  border: 0;
  border-top: 1px solid var(--border-bright);
}

.res-perk-label {
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--text-primary);
  line-height: 1.3;
  margin-bottom: 12px;
}

.res-perk-tools {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.res-perk-tools li {
  min-width: 0;
}

.res-perk-tool {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 48px;
  padding: 6px 0;
  font-size: 15px;
  font-weight: 500;
  color: var(--text-secondary);
  text-decoration: none;
  background: transparent;
  border: 0;
  border-radius: var(--r-sm);
  transition:
    color 180ms ease;
}

.res-perk-tool:hover {
  color: var(--text-primary);
}

.res-perk-tool:focus-visible {
  color: var(--text-primary);
  outline: 2px solid var(--purple-bright);
  outline-offset: 2px;
}

.res-perk-logo {
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  flex: 0 0 32px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r-sm);
  transition:
    background-color 180ms ease,
    border-color 180ms ease;
}

.res-perk-logo img {
  width: 22px;
  height: 22px;
  object-fit: contain;
}

/* Deel's official SVG includes clear space around the lettermark. */
.res-perk-logo img[src="/assets/logos/deel.svg"] {
  width: 30px;
  height: 30px;
}

.res-perk-name {
  min-width: 0;
  line-height: 1.35;
}

.res-perk-tool:hover .res-perk-logo,
.res-perk-tool:focus-visible .res-perk-logo {
  background: var(--bg-elevated);
  border-color: var(--border-accent);
}


@media (max-width: 980px) {
  .res-perks-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--res-divider-space) 40px;
  }

  .res-section-hdr {
    flex-direction: column;
    gap: 12px;
  }
}

@media (max-width: 640px) {
  .res-perks-grid {
    grid-template-columns: 1fr;
    gap: var(--res-divider-space);
  }
}

@media (max-width: 720px) {
  .res-perk-tool {
    min-height: 40px;
  }
}
</style>
