---
import BackLink from "../BackLink.astro";
import TeamCompanies from "../TeamCompanies.astro";
import TeamSocials from "../TeamSocials.astro";
import TeamPortrait from "../TeamPortrait.astro";
import type { PartnerProfile } from "../../data/partnerProfiles";

const { profile } = Astro.props as { profile: PartnerProfile };
---

<div class="page partner-profile-page">
  <section class="partner-profile-hero" aria-labelledby="partner-profile-title">
    <div class="partner-profile-hero-copy">
      <BackLink href="/team" label="Team" />
      <h1 class="partner-profile-title" id="partner-profile-title">{profile.name}</h1>
      <div class="partner-profile-identity">
        {profile.role && <p class="team-person-role">{profile.role}</p>}
        {profile.company && <TeamCompanies company={profile.company} />}
        <TeamSocials socials={profile.socials} align="start" />
      </div>
    </div>
    <figure class="partner-profile-photo">
      <TeamPortrait name={profile.name} photo={profile.photo} eager profile />
    </figure>
  </section>

  <article class="partner-profile-shell">
    {profile.profile.length > 0 && (
      <section class="partner-profile-section">
        <h2>{profile.profileTitle}</h2>
        <div class="partner-profile-copy">
          {profile.profile.map((paragraph) => (
            <p>
              {typeof paragraph === "string"
                ? paragraph
                : paragraph.map((segment) => typeof segment === "string" ? segment : <a href={segment.href} target="_blank" rel="noopener noreferrer">{segment.text}</a>)}
            </p>
          ))}
        </div>
      </section>
    )}

    {profile.questions && profile.questions.length > 0 && (
      <section class="partner-profile-section partner-profile-interview">
        {profile.questions.map((item) => (
          <article class="partner-profile-qa">
            <h2>{item.question}</h2>
            <div class="partner-profile-copy">
              {item.answer.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </article>
        ))}
      </section>
    )}

    {profile.recommendations && profile.recommendations.length > 0 && (
      <section class="partner-profile-section">
        <h2>Reading recommendations</h2>
        <ul class="partner-profile-list">
          {profile.recommendations.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    {profile.companiesBuilt.length > 0 && (
      <section class="partner-profile-section">
        <h2>Companies built</h2>
        <ul class="partner-company-list">
          {profile.companiesBuilt.map((company) => <li>{company}</li>)}
        </ul>
      </section>
    )}

    <section class="partner-profile-section">
      <h2>Build with 886 Studios</h2>
      <div class="partner-profile-copy">
        <p><a href="/ikigai-launchpad">ikigai Launchpad</a> is a startup accelerator run by 886 Studios in Taipei. Explore the program's company-building support, or browse our <a href="/resources">founder guides</a> for advice on applications, fundraising, and building a company.</p>
      </div>
    </section>
  </article>
</div>
