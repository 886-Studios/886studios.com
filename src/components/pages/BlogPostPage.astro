---
import ArticleSubscribe from "../ArticleSubscribe.astro";
import BackLink from "../BackLink.astro";
import { getBlogAuthorHref } from "../../lib/blog";
import {
  blogConfig,
  formatBlogDate,
} from "../../lib/substack";
import type { BlogPost } from "../../types/blog";

const { post } = Astro.props as { post: BlogPost };
const hasLocalContent = Astro.slots.has("default");
const authorHref = getBlogAuthorHref(post.author);
---

<article class="page blog-post-page">
  <header class="blog-post-header">
    <div class="blog-post-header-inner">
      <BackLink href="/blog" label={blogConfig.label} />

      <div class="blog-post-publication">
        {post.source === "substack" ? (
          <a
            href={blogConfig.publicationUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics-event="substack_publication_opened"
            data-analytics-placement="blog_post_header"
          >
            {blogConfig.publicationName}
          </a>
        ) : (
          "886 Studios"
        )}
      </div>
      <h1>{post.title}</h1>
      {post.description && <p class="blog-post-dek">{post.description}</p>}

      <div class="blog-post-byline">
        <span>
          By{" "}
          {authorHref ? (
            <a class="blog-post-author-link" href={authorHref}>{post.author}</a>
          ) : (
            post.author
          )}
        </span>
        <span aria-hidden="true">·</span>
        <time datetime={post.publishedAt}>{formatBlogDate(post.publishedAt)}</time>
        <span aria-hidden="true">·</span>
        <span>{post.readingMinutes} min read</span>
      </div>
    </div>
  </header>

  <div class="pg-divider"></div>

  <div class="blog-post-layout">
    <div class="blog-post-content">
      {hasLocalContent ? <slot /> : <Fragment set:html={post.contentHtml ?? ""} />}
    </div>

    <ArticleSubscribe placement={post.slug} />
  </div>

  {post.substackUrl && (
    <footer class="blog-post-footer">
      <div class="blog-post-footer-inner">
        <div class="blog-post-origin">
          <span>Originally published in</span>
          <a
            href={post.substackUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics-event="substack_post_opened"
            data-analytics-placement="blog_post_footer"
            data-analytics-label={post.title}
          >
            {blogConfig.publicationName}
          </a>
        </div>
      </div>
    </footer>
  )}
</article>
