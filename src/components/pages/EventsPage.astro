---
import EventCard from "../EventCard.astro";
import PageHero from "../PageHero.astro";
import { siteContent } from "../../data/siteContent";
import type { LumaEventCard, LumaEventsResult } from "../../lib/luma";

const { events } = siteContent;
const { lumaEvents } = Astro.props as { lumaEvents: LumaEventsResult };

function groupEventsByYear(items: LumaEventCard[]) {
  return items.reduce<Array<{ year: string; events: LumaEventCard[] }>>((groups, item) => {
    const existing = groups.find((group) => group.year === item.year);

    if (existing) {
      existing.events.push(item);
    } else {
      groups.push({ year: item.year, events: [item] });
    }

    return groups;
  }, []);
}

const pastEventsByYear = groupEventsByYear(lumaEvents.pastEvents);
const eventCountLabel = (count: number) => `${count} ${count === 1 ? "event" : "events"}`;
---

<div class="page" id="page-events">
  <PageHero title={events.title} lead={events.lead} accentHeader />
  <div class="section">
    <section class="events-section" aria-labelledby="upcoming-events-title">
      <header class="events-section-heading">
        <h2 class="events-section-title" id="upcoming-events-title">{events.upcomingTitle}</h2>
        <span class="events-section-count">{eventCountLabel(lumaEvents.upcomingEvents.length)}</span>
      </header>
      {
        lumaEvents.upcomingEvents.length > 0 ? (
          <div class="events-list" aria-label="Upcoming events">
            {lumaEvents.upcomingEvents.map((item) => (
              <EventCard event={item} tag="RSVP" highlight />
            ))}
          </div>
        ) : (
          <div class="events-empty" role="status">
            <div class="ev-title">{events.emptyTitle}</div>
            <div class="ev-meta">{events.emptyText}</div>
          </div>
        )
      }
    </section>

    <div class="events-calendar-note">
      <div class="events-calendar-intro">
        <span class="events-calendar-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" />
          </svg>
        </span>
        <div class="events-calendar-copy">
          <div class="ev-title">{events.calendarTitle}</div>
          <div class="ev-meta">{events.calendarText}</div>
        </div>
      </div>
      <a
        class="events-calendar-cta"
        href={events.calendarUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${events.calendarCta} (opens in a new tab)`}
        data-analytics-event="event_calendar_opened"
        data-analytics-placement="events_page"
      >
        <span>{events.calendarCta}</span>
      </a>
    </div>

    {
      lumaEvents.pastEvents.length > 0 && (
        <section class="events-section" aria-labelledby="past-events-title">
          <header class="events-section-heading">
            <h2 class="events-section-title" id="past-events-title">{events.pastTitle}</h2>
            <span class="events-section-count">{eventCountLabel(lumaEvents.pastEvents.length)}</span>
          </header>
          <div class="events-year-stack">
            {pastEventsByYear.map((group) => (
              <section class="events-year-group" aria-labelledby={`past-events-${group.year}`}>
                <h3 class="events-year-heading" id={`past-events-${group.year}`}>
                  <span>{group.year}</span>
                </h3>
                <div class="events-list">
                  {group.events.map((item) => <EventCard event={item} tag="Learn more" />)}
                </div>
              </section>
            ))}
          </div>
        </section>
      )
    }
  </div>
</div>
