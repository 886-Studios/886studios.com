---
import ArticleSubscribe from "../ArticleSubscribe.astro";
import PageHero from "../PageHero.astro";
import { getBlogAuthorHref } from "../../lib/blog";
import {
  blogConfig,
  formatBlogDate,
  getBlogImageSrcset,
  getBlogImageUrl,
} from "../../lib/substack";
import type { BlogPost } from "../../types/blog";

const { posts } = Astro.props as { posts: BlogPost[] };
const [featuredPost, ...archivePosts] = posts;
---

<div class="page blog-page" id="page-blog">
  <PageHero
    title={blogConfig.label}
    titleId="blog-title"
    accentHeader
    showDivider={false}
  />

  <div class="blog-shell">
    {featuredPost ? (
      <>
        <section class="blog-feature" aria-labelledby="blog-latest-heading">
          <div class="blog-section-label" id="blog-latest-heading">Latest</div>
          <article class="blog-feature-link">
            <a
              class="blog-card-hit-link"
              href={`/blog/${featuredPost.slug}`}
              aria-label={`Read ${featuredPost.title}`}
              data-analytics-event="blog_post_opened"
              data-analytics-placement="blog_feature"
              data-analytics-label={featuredPost.title}
            ></a>
            <div class="blog-feature-media">
              {featuredPost.imageUrl ? (
                <img
                  src={getBlogImageUrl(featuredPost.imageUrl, 960)}
                  srcset={getBlogImageSrcset(featuredPost.imageUrl)}
                  sizes="(max-width: 720px) calc(100vw - 36px), (max-width: 1180px) 48vw, 560px"
                  alt=""
                  width={featuredPost.imageWidth ?? 1600}
                  height={featuredPost.imageHeight ?? 900}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  referrerpolicy="no-referrer"
                />
              ) : (
                <div class="blog-image-fallback" aria-hidden="true">
                  <span>886</span>
                </div>
              )}
            </div>
            <div class="blog-feature-copy">
              <time class="blog-feature-date" datetime={featuredPost.publishedAt}>
                {formatBlogDate(featuredPost.publishedAt)}
              </time>
              <h2>{featuredPost.title}</h2>
              <p>{featuredPost.description}</p>
              {getBlogAuthorHref(featuredPost.author) ? (
                <a
                  class="blog-feature-author blog-author-link"
                  href={getBlogAuthorHref(featuredPost.author)}
                >
                  By {featuredPost.author}
                </a>
              ) : (
                <span class="blog-feature-author">By {featuredPost.author}</span>
              )}
            </div>
          </article>
        </section>

        {archivePosts.length > 0 && (
          <section class="blog-archive" aria-label="More articles">
            <div class="blog-archive-list">
              {archivePosts.map((post) => (
                <article class="blog-archive-item">
                  <a
                    class="blog-card-hit-link"
                    href={`/blog/${post.slug}`}
                    aria-label={`Read ${post.title}`}
                    data-analytics-event="blog_post_opened"
                    data-analytics-placement="blog_archive"
                    data-analytics-label={post.title}
                  ></a>
                  <time class="blog-archive-date" datetime={post.publishedAt}>
                    {formatBlogDate(post.publishedAt, "short")}
                  </time>
                  <span class="blog-archive-main">
                    <span class="blog-archive-title">{post.title}</span>
                    <span class="blog-archive-description">{post.description}</span>
                    {getBlogAuthorHref(post.author) ? (
                      <a
                        class="blog-archive-author blog-author-link"
                        href={getBlogAuthorHref(post.author)}
                      >
                        By {post.author}
                      </a>
                    ) : (
                      <span class="blog-archive-author">By {post.author}</span>
                    )}
                  </span>
                  <span class="blog-archive-media">
                    {post.imageUrl ? (
                      <img
                        src={getBlogImageUrl(post.imageUrl, 640)}
                        srcset={getBlogImageSrcset(post.imageUrl, [320, 640, 960])}
                        sizes="(max-width: 520px) calc(100vw - 40px), 220px"
                        alt=""
                        width={post.imageWidth ?? 1600}
                        height={post.imageHeight ?? 900}
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                      />
                    ) : (
                      <span class="blog-image-fallback" aria-hidden="true">
                        <span>886</span>
                      </span>
                    )}
                  </span>
                </article>
              ))}
            </div>
          </section>
        )}
      </>
    ) : (
      <section class="blog-empty" aria-labelledby="blog-empty-heading">
        <div class="blog-section-label">Latest</div>
        <h2 id="blog-empty-heading">The feed is taking a moment.</h2>
        <p>Read the latest edition directly on 886 Insights.</p>
        <a
          href={blogConfig.publicationUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="substack_publication_opened"
          data-analytics-placement="blog_empty"
        >
          Open 886 Insights
        </a>
      </section>
    )}

    <ArticleSubscribe
      placement="blog-index"
      analyticsPlacement="blog_index"
      contained
    />
  </div>
</div>
