---
import ResourceGuide from "../ResourceGuide.astro";
import ResourceGuideHero from "../ResourceGuideHero.astro";
import type { ResourceArticle } from "../../data/resourceArticles";
import { getSafeInternalOrHttpsHref, isExternalHttpsHref } from "../../lib/urls";

const { article } = Astro.props as { article: ResourceArticle };
const sections = article.sections ?? [];
const groups = article.directoryGroups ?? [];
const sectionId = (title: string, index: number) =>
  `${title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}-${index + 1}`;
const contents = [...sections, ...groups].map((section, index) => ({
  title: section.title,
  id: sectionId(section.title, index),
}));
// An article without a separate introduction opens with its existing first paragraph.
const intro = article.intro ?? sections[0]?.paragraphs?.[0];
---

<ResourceGuide>
  <ResourceGuideHero
    title={article.title}
    backHref={article.parent?.href}
    backLabel={article.parent?.label}
  >
    {intro && <p class="guide-lead mt-6">{intro}</p>}
    {contents.length > 1 && (
      <nav aria-label="In this guide" class="guide-contents guide-small mt-9">
        {contents.map((item) => <a class="guide-link" href={`#${item.id}`}>{item.title}</a>)}
      </nav>
    )}
  </ResourceGuideHero>

  {sections.map((section, index) => (
    <section id={contents[index].id} aria-labelledby={`${contents[index].id}-title`}>
      <div class="guide-container guide-prose">
        <h2 id={`${contents[index].id}-title`}>{section.title}</h2>
        {section.paragraphs?.map((paragraph, paragraphIndex) =>
          !article.intro && index === 0 && paragraphIndex === 0 ? null : <p>{paragraph}</p>
        )}
        {section.list && <ul class="guide-list">{section.list.map((item) => <li>{item}</li>)}</ul>}
        {section.subsections && (
          <div class="guide-stack">
            {section.subsections.map((subsection) => (
              <div>
                <h3>{subsection.title}</h3>
                {subsection.body && <p>{subsection.body}</p>}
                {subsection.list && <ul class="guide-list">{subsection.list.map((item) => <li>{item}</li>)}</ul>}
              </div>
            ))}
          </div>
        )}
        {section.cards && (
          <ul class="guide-topic-links guide-stack" role="list">
            {section.cards.map((card) => {
              const href = getSafeInternalOrHttpsHref(card.href);
              return (
                <li>
                  <h3>{href ? <a class="guide-link" href={href}>{card.title}</a> : card.title}</h3>
                  {card.meta && <div class="guide-meta">{card.meta}</div>}
                  {card.body && <p>{card.body}</p>}
                </li>
              );
            })}
          </ul>
        )}
        {section.table && (
          <>
            <p class="guide-mobile-only guide-small">Scroll the table sideways to read all columns.</p>
            <div class="guide-table-scroll mt-6" tabindex="0" role="region" aria-label={`${section.title} table, horizontally scrollable`}>
              <table style={`--guide-table-columns: ${section.table.headers.length}`}>
                <caption class="sr-only">{section.title}</caption>
                <thead><tr>{section.table.headers.map((header) => <th scope="col">{header}</th>)}</tr></thead>
                <tbody>{section.table.rows.map((row) => <tr>{row.map((cell, cellIndex) => cellIndex === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody>
              </table>
            </div>
          </>
        )}
        {section.links && (
          <div class="guide-links">
            {section.links.map((link) => {
              const href = getSafeInternalOrHttpsHref(link.href);
              if (!href) return null;
              const external = isExternalHttpsHref(href);
              return (
                <a class="guide-link guide-inline" href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>
                  {link.label}{external && <span class="sr-only"> (opens in a new tab)</span>}
                </a>
              );
            })}
          </div>
        )}
      </div>
    </section>
  ))}

  {groups.map((group, index) => {
    const id = contents[sections.length + index].id;
    return (
      <section id={id} aria-labelledby={`${id}-title`}>
        <div class="guide-container guide-prose">
          <h2 id={`${id}-title`}>{group.title}</h2>
          <div class="guide-directory">
            {group.entries.map((entry) => {
              const websiteHref = getSafeInternalOrHttpsHref(entry.href) ?? getSafeInternalOrHttpsHref(entry.url ? `https://${entry.url}` : undefined);
              const external = websiteHref && isExternalHttpsHref(websiteHref);
              return (
                <article>
                  <div class="guide-directory-heading">
                    <h3>{entry.name}</h3>
                    {entry.year && <span class="guide-small">{entry.year}</span>}
                  </div>
                  {entry.focus && <p>{entry.focus}</p>}
                  <dl>
                    {entry.url && <><dt>Website</dt><dd>{websiteHref ? <a class="guide-link" href={websiteHref} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>{entry.url}{external && <span class="sr-only"> (opens in a new tab)</span>}</a> : entry.url}</dd></>}
                    {entry.contact && <><dt>Contact</dt><dd>{entry.contact}</dd></>}
                    {entry.range && <><dt>Range</dt><dd>{entry.range}</dd></>}
                    {entry.stage && <><dt>Stage</dt><dd>{entry.stage}</dd></>}
                  </dl>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    );
  })}
</ResourceGuide>
