---
import PageHero from "../PageHero.astro";
import { siteContent } from "../../data/siteContent";

const { resources } = siteContent;

const libraryGroups = [
  { id: "foundations", title: "Starting a company" },
  { id: "fundraising", title: "Ownership & fundraising" },
  { id: "accelerators", title: "Applying to accelerators" },
  { id: "ecosystem", title: "Networks & programs" },
];

---

<div class="page resources-page" id="page-resources">
  <PageHero
    title={resources.title}
    titleId="resources-title"
    accentHeader
    lead="Tools, guides, and community access to help founders build, launch, and scale across Taiwan and beyond."
    showDivider={false}
  />

  <div class="res-shell">

    <section class="res-section res-library" aria-label="Resource library">
      {libraryGroups.map((group) => (
        <section class="res-library-group" aria-labelledby={`res-group-${group.id}`}>
          <h2 class="res-library-heading" id={`res-group-${group.id}`}>{group.title}</h2>
          <ul class="res-card-grid" role="list">
            {resources.libraryItems.filter((item) => item.group === group.id).map((item) => (
              <li>
                <a class="res-card" href={item.href} aria-labelledby={`res-guide-${item.href.split("/").pop()}`}>
                  <h3 class="res-card-title" id={`res-guide-${item.href.split("/").pop()}`}>{item.title}</h3>
                  <p class="res-card-desc">{item.description}</p>
                  <span class="res-card-cta">
                    {item.ctaLabel}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </section>

    <!-- AMA Feature Card -->
    <section class="res-section res-ama" aria-labelledby="res-ama-heading">
      <div class="res-ama-card">
        <div class="res-ama-body">
          <h2 class="section-h2 section-h2--compact" id="res-ama-heading">{resources.ama.title}</h2>
          <p class="res-ama-lead">{resources.ama.lead}</p>
          <a
            class="btn-pri"
            href={resources.ama.ctaHref}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics-event="founder_ama_opened"
            data-analytics-placement="resources_ama"
          >
            {resources.ama.ctaLabel}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>

        <div class="res-ama-panel">
          <h3 class="res-ama-panel-label">How it works</h3>
          <ol class="res-ama-steps" role="list">
            <li>
              <span class="res-step-num">1</span>
              <span>Submit your question anonymously</span>
            </li>
            <li>
              <span class="res-step-num">2</span>
              <span>Reviewed by our venture partners</span>
            </li>
            <li>
              <span class="res-step-num">3</span>
              <span>Receive a thoughtful, experienced response</span>
            </li>
          </ol>
        </div>
      </div>
    </section>

  </div>
</div>
