---
import PageHero from "../PageHero.astro";
import { siteContent } from "../../data/siteContent";

const { resources } = siteContent;

const libraryGroups = [
  { id: "foundations", title: "Startup fundamentals" },
  { id: "fundraising", title: "Finance & funding" },
  { id: "accelerators", title: "Programs" },
  { id: "ecosystem", title: "Ecosystem" },
].map((group) => ({
  ...group,
  count: resources.libraryItems.filter((item) => item.group === group.id).length,
})).filter((group) => group.count > 0);

---

<div class="page resources-page" id="page-resources">
  <PageHero
    title={resources.title}
    titleId="resources-title"
    accentHeader
    lead="Tools, guides, and community access to help founders build, launch, and scale across Taiwan and beyond."
    showDivider={false}
  />

  <div class="res-shell">

    <section class="res-section res-library" aria-label="Resource library">
      <resource-library>
        <h2 class="sr-only">Resource library</h2>
        <div class="res-library-toolbar" data-library-control hidden>
          <div class="res-library-topics">
            <div class="res-library-filters" role="group" aria-label="Filter resources by topic">
              <button type="button" class="res-topic" data-topic="" aria-pressed="true" aria-controls="resource-results">
                All topics <span>{resources.libraryItems.length}</span>
              </button>
              {libraryGroups.map((group) => (
                <button type="button" class="res-topic" data-topic={group.id} aria-pressed="false" aria-controls="resource-results">
                  {group.title} <span>{group.count}</span>
                </button>
              ))}
            </div>
            <label class="res-library-select" for="resource-topic">
              <span class="sr-only">Filter resources by topic</span>
              <select id="resource-topic" aria-controls="resource-results">
                <option value="">All topics ({resources.libraryItems.length})</option>
                {libraryGroups.map((group) => <option value={group.id}>{group.title} ({group.count})</option>)}
              </select>
            </label>
          </div>
          <form class="res-library-search" role="search" aria-label="Search resource library">
            <label class="sr-only" for="resource-search">Search resources</label>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" />
            </svg>
            <input id="resource-search" type="search" placeholder="Search resources…" autocomplete="off" aria-controls="resource-results" />
          </form>
        </div>

        <div class="res-library-title">
          <p class="res-library-count" role="status" aria-atomic="true" data-result-count>
            {resources.libraryItems.length} resources
          </p>
          <button class="res-library-reset" type="button" hidden>Clear filters</button>
        </div>

        <ul class="res-library-list" id="resource-results" role="list">
          {resources.libraryItems.map((item, index) => (
            <li data-resource data-group={item.group} data-search={`${item.title} ${item.description} ${libraryGroups.find((group) => group.id === item.group)?.title ?? ""}`.toLowerCase()}>
              <a class="res-library-link" href={item.href} aria-labelledby={`resource-title-${index}`}>
                <h3 class="res-library-item-title" id={`resource-title-${index}`}>{item.title}</h3>
                <p class="res-library-description">{item.description}</p>
                <span class="sr-only">{item.ctaLabel}</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="res-library-empty" hidden>
          <h3>No matching resources</h3>
          <p>Try a different search or clear the filters to browse all resources.</p>
        </div>
        <button class="res-library-more" type="button" aria-controls="resource-results" hidden>Show more resources</button>
      </resource-library>
    </section>

    <hr class="divider divider--spaced" />

    <!-- AMA Feature Card -->
    <section class="res-section res-ama" aria-labelledby="res-ama-heading">
      <div class="res-ama-card">
        <div class="res-ama-body">
          <h2 class="section-h2 section-h2--compact" id="res-ama-heading">{resources.ama.title}</h2>
          <p class="res-ama-lead">{resources.ama.lead}</p>
          <a
            class="btn-pri"
            href={resources.ama.ctaHref}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics-event="founder_ama_opened"
            data-analytics-placement="resources_ama"
          >
            {resources.ama.ctaLabel}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>

        <div class="res-ama-panel">
          <h3 class="res-ama-panel-label">How it works</h3>
          <ol class="res-ama-steps" role="list">
            <li>
              <span class="res-step-num">1</span>
              <span>Submit your question</span>
            </li>
            <li>
              <span class="res-step-num">2</span>
              <span>Reviewed by our venture partners</span>
            </li>
            <li>
              <span class="res-step-num">3</span>
              <span>Receive a thoughtful, experienced response</span>
            </li>
          </ol>
        </div>
      </div>
    </section>

  </div>
</div>

<script>
  class ResourceLibrary extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = "true";

      const search = this.querySelector<HTMLInputElement>("input")!;
      const select = this.querySelector<HTMLSelectElement>("select")!;
      const topics = [...this.querySelectorAll<HTMLButtonElement>("[data-topic]")];
      const records = [...this.querySelectorAll<HTMLLIElement>("[data-resource]")];
      const count = this.querySelector<HTMLElement>("[data-result-count]")!;
      const empty = this.querySelector<HTMLElement>(".res-library-empty")!;
      const reset = this.querySelector<HTMLButtonElement>(".res-library-reset")!;
      const more = this.querySelector<HTMLButtonElement>(".res-library-more")!;
      const pageSize = 10;
      let visibleLimit = pageSize;

      const update = () => {
        const terms = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
        const matches = records.filter((record) =>
          (!select.value || record.dataset.group === select.value) &&
          terms.every((term) => record.dataset.search!.includes(term)),
        );
        const visible = new Set(matches.slice(0, visibleLimit));
        records.forEach((record) => { record.hidden = !visible.has(record); });
        topics.forEach((topic) => {
          topic.setAttribute("aria-pressed", String(topic.dataset.topic === select.value));
        });
        const noun = matches.length === 1 ? "resource" : "resources";
        count.textContent = visible.size < matches.length
          ? `${visible.size} of ${matches.length} ${noun}`
          : `${matches.length} ${noun}`;
        empty.hidden = matches.length !== 0;
        reset.hidden = !search.value && !select.value;
        more.hidden = visible.size === matches.length;
        more.textContent = `Show ${Math.min(pageSize, matches.length - visible.size)} more`;
      };

      const filter = () => { visibleLimit = pageSize; update(); };
      this.querySelector("form")!.addEventListener("submit", (event) => event.preventDefault());
      search.addEventListener("input", filter);
      select.addEventListener("change", filter);
      topics.forEach((topic) => topic.addEventListener("click", () => {
        select.value = topic.dataset.topic!;
        filter();
      }));
      reset.addEventListener("click", () => {
        search.value = "";
        select.value = "";
        filter();
        search.focus();
      });
      more.addEventListener("click", () => {
        const previouslyVisible = new Set(records.filter((record) => !record.hidden));
        visibleLimit += pageSize;
        update();
        records.find((record) => !record.hidden && !previouslyVisible.has(record))?.querySelector("a")?.focus();
      });
      this.querySelectorAll<HTMLElement>("[data-library-control]").forEach((control) => { control.hidden = false; });
      update();
    }
  }

  if (!customElements.get("resource-library")) customElements.define("resource-library", ResourceLibrary);
</script>
