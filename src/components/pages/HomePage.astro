---
import { siteContent } from "../../data/siteContent";

const { home } = siteContent;
const photoLoopSets = [false, true];
const isExternalHeroCta = home.hero.cta.href.startsWith("http");
const portfolioPreviewSlugs = ["o3o-labs", "preciser", "dentscape", "gitroll", "peeps"];
const portfolioPreviewItems = portfolioPreviewSlugs
  .map((slug) => home.portfolio.find((item) => item.slug === slug))
  .filter((item): item is NonNullable<typeof item> => Boolean(item));
const getPhotoSrcset = (src: string) =>
  `${src.replace("-960.webp", "-480.webp")} 480w, ${src} 960w`;
---

<div class="page" id="page-home">
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-orb orb-1"></div>
      <div class="hero-orb orb-2"></div>
      <div class="hero-orb orb-3"></div>
      <div class="hero-grid"></div>
    </div>
    <div class="hero-inner">
      <h1 class="hero-h1">
        {home.hero.titleLead}<br /><em>{home.hero.titleAccent}</em>
      </h1>
      <p class="hero-sub">
        {home.hero.body.replace(/\s*\n\s*/g, " ")}
      </p>
      <div class="hero-actions">
        <a
          class="btn-pri"
          href={home.hero.cta.href}
          target={isExternalHeroCta ? "_blank" : undefined}
          rel={isExternalHeroCta ? "noopener noreferrer" : undefined}
          data-analytics-event="program_interest"
          data-analytics-placement="home_hero"
          data-analytics-label="886_launchpad"
        >
          {home.hero.cta.label}
        </a>
      </div>
    </div>
  </section>

  <section class="photo-showcase reveal" aria-label="886 Studios photo slideshow">
    <div class="photo-rail" aria-label="886 Studios photo slideshow">
      <div class="photo-track">
        {photoLoopSets.map((isHidden) => (
          <div class="photo-track-set" aria-hidden={isHidden ? "true" : undefined}>
            {
              home.photos.items.map((photo, photoIndex) => (
                <figure class="photo-slide">
                  <img
                    src={photo.src}
                    srcset={getPhotoSrcset(photo.src)}
                    sizes="(max-width: 520px) 72vw, (max-width: 1267px) 30vw, 380px"
                    alt={photo.alt}
                    width={photo.width}
                    height={photo.height}
                    loading={isHidden ? "lazy" : "eager"}
                    fetchpriority={!isHidden && photoIndex < 2 ? "high" : undefined}
                    decoding="async"
                  />
                </figure>
              ))
            }
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Programs strip -->
  <div class="section reveal">
    <h2 class="section-h2">{home.programs.title}</h2>
    <div class="home-programs-flow">
      <article class="home-program-feature">
        <div class="home-program-feature-grid">
          <div>
            <h3 class="home-program-feature-title">{home.programs.featured.title}</h3>
            <p class="home-program-feature-copy">{home.programs.featured.body}</p>
          </div>
          <a
            class="card-cta home-program-feature-link"
            href={home.programs.featured.ctaHref}
            aria-label="Learn more about 886 Launchpad"
            data-analytics-event="program_interest"
            data-analytics-placement="home_program_card"
            data-analytics-label="886_launchpad"
          >
            {home.programs.featured.ctaLabel}
          </a>
        </div>
      </article>
      <div class="home-program-mini-grid">
        {
          home.programs.secondary.map((item) => (
            <article class="home-program-mini">
              <div class="home-program-mini-body">
                <h3 class="home-program-mini-title">{item.title}</h3>
                <p class="home-program-mini-copy">{item.body}</p>
              </div>
              <a
                class="card-cta"
                href={item.ctaHref}
                aria-label={`Learn more about ${item.title}`}
                data-analytics-event="program_interest"
                data-analytics-placement="home_program_card"
                data-analytics-label="launch_station"
              >
                {item.ctaLabel}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <div class="section home-portfolio reveal reveal-delay-1">
    <div class="portfolio-block">
      <h2 class="section-h2">Our portfolio</h2>
      <ul class="portfolio-list" aria-label="Portfolio companies">
        {
          portfolioPreviewItems.map((item) => (
            <li class="portfolio-row">
              <a class="portfolio-link" href={`/portfolio/${item.slug}?from=home`}>
                <span
                  class:list={[
                    "portfolio-logo-mark",
                    item.logo.imageClass === "is-app-icon" && "portfolio-logo-mark--app-icon",
                  ]}
                >
                  <img
                    class:list={["portfolio-logo-image", item.logo.imageClass]}
                    src={item.logo.src}
                    alt={item.logo.alt}
                    width={item.logo.width}
                    height={item.logo.height}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <span class="portfolio-name-group">
                  <span class="portfolio-name">{item.name}</span>
                  <span class="portfolio-category">{item.category}</span>
                </span>
                <span class="portfolio-meta">
                  <span class="sr-only">Open {item.name} portfolio page</span>
                  <span class="portfolio-indicator" aria-hidden="true"></span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="portfolio-see-more" href="/portfolio">See all portfolio companies</a>
    </div>
  </div>

  <!-- Newsletter -->
  <div class="nl-strip">
    <div class="nl-inner">
      <div class="nl-text">
        <h2>
          {home.newsletter.title}{" "}
          <a href={home.newsletter.publicationUrl} target="_blank" rel="noopener noreferrer">
            {home.newsletter.publicationName}
          </a>
        </h2>
        <p>{home.newsletter.body}</p>
      </div>
      <form
        class="nl-form"
        action={home.newsletter.action}
        method="get"
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="newsletter_signup"
        data-analytics-placement="home_newsletter"
      >
        <label class="sr-only" for="newsletter-email">Email address</label>
        <input
          id="newsletter-email"
          class="nl-input"
          type="email"
          name="email"
          placeholder={home.newsletter.placeholder}
          autocomplete="email"
          required
        />
        <button class="nl-btn" type="submit">{home.newsletter.button}<span class="sr-only"> (opens Substack in a new tab)</span></button>
      </form>
    </div>
  </div>
</div>

<script>
  import "../../scripts/home";
</script>
