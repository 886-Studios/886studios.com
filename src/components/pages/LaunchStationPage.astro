---
import { siteContent } from "../../data/siteContent";
import ProgramPerks from "../ProgramPerks.astro";

const { launchStation, launchpad } = siteContent.programs;
---

<div class="page program-page" id="page-launch-station">
  <div class="launch-station-content">
    <section class="launch-station-intro" aria-labelledby="ls-heading">
      <div class="launch-station-intro-copy">
        <h1 class="prog-wordmark" id="ls-heading">
          <span class="sr-only">{launchStation.title}</span>
          <img
            src="/assets/logos/launch-station-wordmark-white.svg"
            alt=""
            width="302"
            height="149"
            decoding="async"
            aria-hidden="true"
          />
        </h1>
        <p class="launch-station-lead">{launchStation.lead}</p>
        <div class="launch-station-actions">
          <a
            class="btn-pri launch-station-contact"
            href={launchStation.joining.cta.href}
            data-analytics-event="program_interest"
            data-analytics-placement="launch_station_hero"
            data-analytics-label="launch_station"
          >
            {launchStation.joining.cta.label}
          </a>
          <a class="launch-station-explore" href="#ls-fit-heading">Explore the residency</a>
        </div>
        <p class="launch-station-status">{launchStation.status}</p>
      </div>
      <dl class="launch-station-facts" aria-label="Launch Station facts">
        {launchStation.essentials.map((item) => (
          <div class="prog-brief-fact">
            <dt>{item.label}</dt>
            <dd><strong>{item.value}</strong>{item.note && <span>{item.note}</span>}</dd>
          </div>
        ))}
      </dl>
      <figure class="launch-station-photo">
        <img
          src={launchStation.heroPhoto.src}
          srcset={launchStation.heroPhoto.srcset}
          sizes="(max-width: 640px) calc(100vw - 48px), (max-width: 704px) calc(100vw - 64px), (max-width: 860px) 640px, (max-width: 1160px) 40vw, 470px"
          alt={launchStation.heroPhoto.alt}
          width={launchStation.heroPhoto.width}
          height={launchStation.heroPhoto.height}
          decoding="async"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </section>

    <section class="launch-station-fit" aria-labelledby="ls-fit-heading">
      <h2 id="ls-fit-heading" tabindex="-1">{launchStation.fit.title}</h2>
      <dl class="launch-station-criteria">
        {launchStation.fit.criteria.map((criterion) => (
          <div>
            <dt>{criterion.label}</dt>
            <dd>{criterion.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="ls-benefits-heading">
      <h2 id="ls-benefits-heading">{launchStation.benefitsTitle}</h2>
      <dl class="launch-station-benefits">
        {launchStation.benefits.map((benefit) => (
          <div>
            <dt>{benefit.title}</dt>
            <dd>{benefit.body}</dd>
          </div>
        ))}
      </dl>
      <div class="launch-station-community-photos">
        {launchStation.communityPhotos.map((photo) => (
          <img
            src={photo.src}
            srcset={photo.srcset}
            sizes="(max-width: 560px) calc(100vw - 48px), (max-width: 640px) calc(100vw - 64px), (max-width: 1160px) calc(50vw - 44px), 536px"
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    </section>

    <section class="launch-station-contribution" aria-labelledby="ls-contribution-heading">
      <h2 id="ls-contribution-heading">Being part of the community</h2>
      <p>{launchStation.contribution}</p>
      <ul class="launch-station-activities" aria-label="Community activities">
        {launchStation.activities.map((activity) => <li>{activity}</li>)}
      </ul>
    </section>

    <ProgramPerks id="ls-perks" program={launchStation.title} />

    <section class="launch-station-joining" aria-labelledby="ls-joining-heading">
      <h2 id="ls-joining-heading">{launchStation.joining.title}</h2>
      <p>{launchStation.joining.body}</p>
      <a
        class="btn-pri launch-station-contact"
        href={launchStation.joining.cta.href}
        data-analytics-event="program_interest"
        data-analytics-placement="launch_station_joining"
        data-analytics-label="launch_station"
      >
        {launchStation.joining.cta.label}
      </a>
      <p class="launch-station-email">Email <a href={launchStation.joining.cta.href}>carter@886studios.com</a> about Launch Station.</p>
    </section>

    <a class="prog-launch launch-station-alternative" href="/ikigai-launchpad" aria-labelledby="ls-launchpad-heading">
      <figure class="prog-launch-media">
        <img
          src="/assets/landing/launchpad-01-480.webp"
          alt="Founders and the ikigai Launchpad community"
          width="480"
          height="270"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="prog-launch-content">
        <span class="prog-band-label">Also available</span>
        <div class="prog-launch-copy">
          <h2 class="prog-launch-name" id="ls-launchpad-heading">{launchpad.name}</h2>
          <p class="prog-launch-body">Looking for funding and structured mentor support? Explore ikigai Launchpad, our 10-week accelerator in Taipei, with $100K USD and weekly mentor office hours.</p>
        </div>
      </div>
      <span class="prog-launch-status">Explore ikigai Launchpad →</span>
    </a>
  </div>
</div>
