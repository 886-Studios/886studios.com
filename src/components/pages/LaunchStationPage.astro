---
import { siteContent } from "../../data/siteContent";
import ProgramPerks from "../ProgramPerks.astro";

const { launchStation } = siteContent.programs;
---

<div class="page program-page" id="page-launch-station">
  <div class="launch-station-content">
    <section class="launch-station-intro" aria-labelledby="ls-heading">
      <div class="launch-station-intro-copy">
        <h1 class="program-heading" id="ls-heading">{launchStation.title}</h1>
        <p class="program-lead">{launchStation.lead}</p>
        <p class="launch-station-introduction">{launchStation.introduction}</p>
        <div class="program-hero-actions">
          <a
            class="btn-pri program-hero-cta"
            href={launchStation.joining.cta.href}
            data-analytics-event="program_interest"
            data-analytics-placement="launch_station_hero"
            data-analytics-label="launch_station"
          >
            {launchStation.joining.cta.label}
          </a>
          <p class="program-hero-status">{launchStation.status}</p>
        </div>
      </div>
      <dl class="launch-station-facts" aria-label="886 Residency facts">
        {launchStation.essentials.map((item) => (
          <div class="prog-brief-fact">
            <dt>{item.label}</dt>
            <dd><strong>{item.value}</strong></dd>
          </div>
        ))}
      </dl>
      <figure class="launch-station-photo">
        <img
          src={launchStation.heroPhoto.src}
          srcset={launchStation.heroPhoto.srcset}
          sizes="(max-width: 528px) calc(100vw - 48px), (max-width: 860px) 480px, (max-width: 1160px) 40vw, 470px"
          alt={launchStation.heroPhoto.alt}
          width={launchStation.heroPhoto.width}
          height={launchStation.heroPhoto.height}
          decoding="async"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </section>

    <section class="launch-station-fit" aria-labelledby="ls-fit-heading">
      <h2 id="ls-fit-heading" tabindex="-1">{launchStation.fit.title}</h2>
      <dl class="launch-station-criteria">
        {launchStation.fit.criteria.map((criterion) => (
          <div>
            <dt>{criterion.label}</dt>
            <dd>{criterion.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="ls-how-heading">
      <h2 id="ls-how-heading">{launchStation.howItWorks.title}</h2>
      <ul class="launch-station-activities">
        {launchStation.howItWorks.items.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section aria-labelledby="ls-benefits-heading">
      <h2 id="ls-benefits-heading">{launchStation.benefitsTitle}</h2>
      <dl class="launch-station-benefits">
        {launchStation.benefits.map((benefit) => (
          <div>
            <dt>{benefit.title}</dt>
            <dd>{benefit.body}</dd>
          </div>
        ))}
      </dl>
      <div class="launch-station-community-photos">
        {launchStation.communityPhotos.map((photo) => (
          <img
            src={photo.src}
            srcset={photo.srcset}
            sizes="(max-width: 560px) calc(100vw - 48px), (max-width: 640px) calc(100vw - 64px), (max-width: 1160px) calc(50vw - 44px), 536px"
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    </section>

    <section class="launch-station-contribution" aria-labelledby="ls-contribution-heading">
      <h2 id="ls-contribution-heading">{launchStation.expectations.title}</h2>
      <dl class="launch-station-criteria">
        {launchStation.expectations.items.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="ls-support-heading">
      <h2 id="ls-support-heading">{launchStation.support.title}</h2>
      <dl class="launch-station-criteria">
        {launchStation.support.items.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <ProgramPerks id="ls-perks" program={launchStation.title} />

    <section class="launch-station-alternative" aria-labelledby="ls-launchpad-heading">
      <h2 id="ls-launchpad-heading">{launchStation.accelerator.title}</h2>
      <p>{launchStation.accelerator.body}</p>
      <a class="launch-station-explore" href={launchStation.accelerator.cta.href}>
        {launchStation.accelerator.cta.label}
      </a>
    </section>

    <section class="launch-station-joining" aria-labelledby="ls-joining-heading">
      <div class="launch-station-joining-copy">
        <h2 id="ls-joining-heading">{launchStation.joining.title}</h2>
        <p>{launchStation.joining.body} Email <a href="mailto:carter@886studios.com">carter@886studios.com</a>.</p>
      </div>
      <a
        class="btn-pri launch-station-contact"
        href={launchStation.joining.cta.href}
        data-analytics-event="program_interest"
        data-analytics-placement="launch_station_joining"
        data-analytics-label="launch_station"
      >
        {launchStation.joining.cta.label}
      </a>
    </section>
  </div>
</div>
