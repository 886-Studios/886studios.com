---
import PageHero from "../PageHero.astro";
import { siteContent } from "../../data/siteContent";

const { about } = siteContent;
---

<div class="page" id="page-about">
  <PageHero title={about.title} lead={about.lead} accentHeader />
  <div class="section about-content">
    <div class="about-cols reveal">
      {
        about.columns.map((column) => (
          <div class="about-col">
            <div class="section-tag about-column-tag">{column.eyebrow}</div>
            {column.title && <h2 class="section-h2 section-h2--compact">{column.title}</h2>}
            {column.paragraphs.map((paragraph, index) => (
              <p class:list={["prose", index > 0 && "prose--spaced"]}>{paragraph}</p>
            ))}
          </div>
        ))
      }
    </div>

    <hr class="divider divider--spaced">

    <section class="about-companies reveal" aria-labelledby="about-companies-title">
      <h2 class="section-tag about-column-tag" id="about-companies-title">{about.companies.title}</h2>
      <div class="logo-wall">
        {
          about.companies.logos.map((logo) => (
            <div class="logo-card">
              <div class="logo-stage">
                <img
                  class:list={["logo-image", logo.imageClass]}
                  src={logo.src}
                  alt={logo.alt}
                  width={logo.width}
                  height={logo.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="logo-caption">{logo.name}</div>
            </div>
          ))
        }
      </div>
    </section>

    <hr class="divider divider--spaced">

    <div class="reveal reveal-delay-1">
      <div class="section-tag">{about.collaboration.eyebrow}</div>
      <section class="about-collaboration" aria-labelledby="about-collaboration-title">
        <div class="about-collaboration-brand">
          <img
            src={about.collaboration.logo.src}
            alt={about.collaboration.logo.alt}
            width={about.collaboration.logo.width}
            height={about.collaboration.logo.height}
            loading="lazy"
            decoding="async"
          />
          <div>
            <h2 id="about-collaboration-title">{about.collaboration.title}</h2>
          </div>
        </div>

        <div class="about-collaboration-copy">
          <p>{about.collaboration.description}</p>
          <p>
            <a href={about.collaboration.program.href}>
              {about.collaboration.program.label}
            </a>{" "}
            {about.collaboration.programDescription}
          </p>
        </div>

        <div class="about-collaboration-links" aria-label="Lifelike Capital links">
          {about.collaboration.links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${about.collaboration.title} ${link.label}`}
              title={link.label}
            >
              {link.label === "LinkedIn" ? (
                <svg class="about-collaboration-linkedin" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4.98 3.5a1.75 1.75 0 1 1 0 3.5 1.75 1.75 0 0 1 0-3.5ZM3.5 8.5h2.96V20.5H3.5V8.5Zm5.28 0h2.84v1.64h.04c.4-.75 1.37-1.84 3.34-1.84 3.57 0 4.23 2.35 4.23 5.41v6.79h-2.96v-6.01c0-1.43-.03-3.27-1.99-3.27-2 0-2.31 1.56-2.31 3.17v6.11H8.78V8.5Z" />
                </svg>
              ) : (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <ellipse cx="12" cy="12" rx="4" ry="9" />
                  <path d="M3 12h18" />
                </svg>
              )}
            </a>
          ))}
        </div>
      </section>
    </div>

  </div>
</div>

<style>
  .about-content {
    padding-top: clamp(var(--space-lg), 4vw, var(--space-xl));
  }

  .about-companies .logo-wall {
    padding-top: 0;
    border-top: 0;
  }

</style>
