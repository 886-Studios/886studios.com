---
import "../styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import VercelAnalytics from "../components/VercelAnalytics.astro";
import {
  getCanonicalUrl,
  getGoogleAnalyticsId,
  getRouteImagePreloads,
  getSearchEngineVerification,
  normalizePath,
  productionAnalyticsEnabled,
  siteConfig,
} from "../config/site";
import {
  getAbsoluteUrl,
  getImageMimeType,
  getStructuredDataGraph,
  type BreadcrumbItem,
  type JsonLdObject,
  type PageSchemaType,
} from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  dateModified?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  ogType?: string;
  robots?: string;
  pageType?: PageSchemaType;
  breadcrumbs?: BreadcrumbItem[];
  structuredData?: JsonLdObject | JsonLdObject[];
  hideFooterSocials?: boolean;
  canonical?: string | false;
}

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.defaultDescription,
  dateModified,
  ogImage = siteConfig.defaultOgImage,
  ogImageAlt = siteConfig.ogImageAlt,
  ogImageWidth = siteConfig.defaultOgImageWidth,
  ogImageHeight = siteConfig.defaultOgImageHeight,
  ogImageType,
  ogType = "website",
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  pageType = "WebPage",
  breadcrumbs,
  structuredData,
  hideFooterSocials = false,
  canonical,
} = Astro.props;

const currentPath = normalizePath(Astro.url.pathname);
const isManifestoPage = currentPath === "/manifesto";
const isPortfolioProfilePage = currentPath.startsWith("/portfolio/");
const canonicalUrl = canonical === false ? undefined : canonical ?? getCanonicalUrl(currentPath);
const showSocialPreview = Boolean(canonicalUrl) && !/\bnoindex\b/i.test(robots);
const showSocialPreviewImage = showSocialPreview && Boolean(ogImage);
const absoluteOgImage = showSocialPreviewImage ? getAbsoluteUrl(ogImage) : undefined;
const resolvedOgImageType = ogImageType ?? getImageMimeType(ogImage) ?? siteConfig.defaultOgImageType;
const twitterCard = ogImageWidth / ogImageHeight >= 1.5 ? "summary_large_image" : "summary";
const googleAnalyticsId = getGoogleAnalyticsId();
const searchEngineVerification = getSearchEngineVerification();
const routeImagePreloads = getRouteImagePreloads(currentPath);
const structuredDataJson = canonicalUrl
  ? JSON.stringify(
      getStructuredDataGraph({
        path: currentPath,
        title,
        description,
        dateModified,
        pageType,
        breadcrumbs,
        additionalSchema: structuredData,
        image: absoluteOgImage
          ? {
              url: absoluteOgImage,
              alt: ogImageAlt,
              width: ogImageWidth,
              height: ogImageHeight,
            }
          : undefined,
      }),
    ).replace(/</g, "\\u003c")
  : undefined;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <GoogleAnalytics measurementId={googleAnalyticsId} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="application-name" content={siteConfig.name} />
    <meta name="author" content={siteConfig.name} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {searchEngineVerification.google && (
      <meta name="google-site-verification" content={searchEngineVerification.google} />
    )}
    {searchEngineVerification.bing && (
      <meta name="msvalidate.01" content={searchEngineVerification.bing} />
    )}
    {searchEngineVerification.yandex && (
      <meta name="yandex-verification" content={searchEngineVerification.yandex} />
    )}
    {searchEngineVerification.baidu && (
      <meta name="baidu-site-verification" content={searchEngineVerification.baidu} />
    )}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="sitemap" type="application/xml" href={`${siteConfig.url}/sitemap.xml`} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="886 Studios Blog"
      href={`${siteConfig.url}/rss.xml`}
    />
    {currentPath === "/" && (
      <link
        rel="alternate"
        type="text/markdown"
        title="886 Studios machine-readable summary"
        href={`${siteConfig.url}/llms.txt`}
      />
    )}

    {
      showSocialPreview && (
        <>
          <meta property="og:type" content={ogType} />
          <meta property="og:url" content={canonicalUrl} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          {
            absoluteOgImage && (
              <>
                <meta property="og:image" content={absoluteOgImage} />
                <meta property="og:image:url" content={absoluteOgImage} />
                <meta property="og:image:secure_url" content={absoluteOgImage} />
                <meta property="og:image:type" content={resolvedOgImageType} />
                <meta property="og:image:width" content={String(ogImageWidth)} />
                <meta property="og:image:height" content={String(ogImageHeight)} />
                <meta property="og:image:alt" content={ogImageAlt} />
              </>
            )
          }
          <meta property="og:site_name" content={siteConfig.name} />
          <meta property="og:locale" content={siteConfig.ogLocale} />
          <meta name="twitter:card" content={absoluteOgImage ? twitterCard : "summary"} />
          <meta name="twitter:site" content={siteConfig.twitterSite} />
          <meta name="twitter:domain" content="886studios.com" />
          <meta name="twitter:url" content={canonicalUrl} />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          {
            absoluteOgImage && (
              <>
                <meta name="twitter:image" content={absoluteOgImage} />
                <meta name="twitter:image:alt" content={ogImageAlt} />
              </>
            )
          }
        </>
      )
    }

    <meta name="theme-color" content={siteConfig.themeColor} />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/avif" href="/favicon.avif" />
    <link rel="shortcut icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="32x32" href="/favicon-32.png" />
    {
      routeImagePreloads.map((image) => (
        <link
          rel="preload"
          as="image"
          href={image.href}
          imagesrcset={image.srcset}
          imagesizes={image.sizes}
          type={image.type}
          fetchpriority="high"
        />
      ))
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href={isManifestoPage
        ? "https://fonts.googleapis.com/css2?family=Geist:wght@400..750&family=Geist+Mono:wght@400..700&display=swap"
        : "https://fonts.googleapis.com/css2?family=Geist:wght@400..750&display=swap"}
      rel="stylesheet"
    />
    {structuredDataJson && <script type="application/ld+json" is:inline set:html={structuredDataJson} />}
  </head>
  <body class:list={[currentPath === "/" && "is-home", isPortfolioProfilePage && "is-portfolio-profile", isManifestoPage && "is-manifesto", currentPath === "/resources/application-guide" && "is-application-guide"]}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header>
      <SiteNav currentPath={currentPath} />
    </header>
    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter hideSocials={hideFooterSocials} />
    <VercelAnalytics />
    {productionAnalyticsEnabled && <SpeedInsights />}
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
