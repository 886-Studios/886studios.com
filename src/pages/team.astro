---
import AboutTeam from "../components/AboutTeam.astro";
import PageHero from "../components/PageHero.astro";
import TeamSocials from "../components/TeamSocials.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteContent } from "../data/siteContent";
import { getPeopleItemListSchema, pageMeta } from "../lib/seo";

const { careers } = siteContent.about;
const ventureScouts = [
  { name: "Joseph Chu", linkedinUrl: "https://www.linkedin.com/in/yu-shan-chu-8b0335351/" },
  { name: "Lex Galo Dy", linkedinUrl: "https://www.linkedin.com/in/lex-galo-dy-6b92063bb/" },
];
---

<BaseLayout
  title={pageMeta.team.title}
  description={pageMeta.team.description}
  pageType="AboutPage"
  breadcrumbs={[
    { name: "About us", path: "/about" },
    { name: "Team", path: "/team" },
  ]}
  structuredData={getPeopleItemListSchema("/team")}
>
  <div class="page" id="page-team">
    <PageHero title="Our People" accentHeader />
    <div class="section team-content">
      <AboutTeam />

      <section class="venture-scouts" aria-labelledby="venture-scouts-title" id="venture-scouts">
        <h2 class="section-tag about-column-tag" id="venture-scouts-title">Venture Scouts</h2>
        <ul class="scouts-list" role="list">
          {ventureScouts.map((scout) => (
            <li class="scout">
              <h3 class="scout-name">{scout.name}</h3>
              <TeamSocials align="start" socials={[{
                platform: "linkedin",
                href: scout.linkedinUrl,
                ariaLabel: `${scout.name} on LinkedIn`,
              }]} />
            </li>
          ))}
        </ul>
      </section>

      <hr class="divider divider--spaced">

      <div class="reveal reveal-delay-1" id="careers">
        <h2 class="section-tag about-column-tag" id="team-careers-title">{careers.title}</h2>
        <section class="team-careers" aria-labelledby="team-careers-title">
          <div class="team-careers-copy">
            <p class="prose">{careers.description}</p>
            <p class="prose">
              {careers.scoutInvitation}{" "}
              <a href={`mailto:${careers.contactEmail}`}>{careers.contactEmail}</a>.
            </p>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  #page-team :global(.pg-hero.accent-hero) {
    padding-block: var(--space-xl) var(--space-lg);
  }
  .team-content { padding-block: var(--space-lg) var(--space-xl); }
  .team-careers-copy a { color: var(--purple-bright); text-underline-offset: 4px; }
  .team-careers-copy a:is(:hover, :focus-visible) { color: var(--text-primary); }
  .venture-scouts { margin-top: var(--space-xl); }
  .scouts-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-xl);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .scout { display: flex; align-items: center; gap: var(--space-xs); }
  .scout-name { font-family: var(--font-display); font-size: 17px; font-weight: 500; line-height: 1.4; }
  .scout :global(.person-socials) { margin-top: 0; }
  #page-team .divider--spaced { margin-block: var(--space-xl); }
  @media (max-width: 760px) {
    .team-content { padding-top: var(--space-md); }
    .venture-scouts { margin-top: var(--space-lg); }
    #page-team .divider--spaced { margin-block: var(--space-lg); }
    #page-team :global(.pg-hero.accent-hero) {
      padding-block: var(--space-lg) var(--space-md);
    }
  }
</style>
