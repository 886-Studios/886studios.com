---
import IncorporationGuidePage from "../components/pages/IncorporationGuidePage.astro";
import { contentDates } from "../data/contentDates.generated";
import { standaloneResourceArticles } from "../data/resourceArticles";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getResourceArticleSchema,
  getResourceDescription,
  getResourceFaqSchema,
  getResourcePageTitle,
} from "../lib/seo";

const article = standaloneResourceArticles.find((item) => item.slug === "incorporation-101");

if (!article) {
  throw new Error("Missing incorporation resource article");
}

const pagePath = "/incorporation-101";
const dateModified = contentDates[pagePath];
const faqSchema = getResourceFaqSchema(article, pagePath);
---

<BaseLayout
  title={getResourcePageTitle(article)}
  description={getResourceDescription(article)}
  dateModified={dateModified}
  ogType="article"
  breadcrumbs={[
    { name: "Resources", path: "/resources" },
    { name: article.title, path: pagePath },
  ]}
  structuredData={[
    getResourceArticleSchema(article, pagePath, dateModified),
    ...(faqSchema ? [faqSchema] : []),
  ]}
>
  <IncorporationGuidePage />
</BaseLayout>
