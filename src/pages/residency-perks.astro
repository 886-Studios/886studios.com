---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contentDates } from "../data/contentDates.generated";
import { residencyPerkCategories, residencyPerkRequestHref } from "../data/residencyPerks";
import "../styles/pages/residency-perks.css";

const perks = residencyPerkCategories.flatMap((category, categoryIndex) =>
  category.items.map((perk) => ({ ...perk, category: category.title, categoryIndex })),
).sort((a, b) => a.label.localeCompare(b.label, "en"));
---

<BaseLayout
  title="Residency Perks | 886 Studios"
  description="Partner perks for 886 Residency members. View offers, eligibility requirements and access links."
  dateModified={contentDates["/residency-perks"]}
  breadcrumbs={[{ name: "886 Residency", path: "/residency" }, { name: "Residency perks", path: "/residency-perks" }]}
  standalone
>
  <header slot="header" class="residency-perks-header">
    <nav class="nav-inner" aria-label="Main navigation">
      <a class="brand" href="/" aria-label="886 Studios home"><img src="/assets/886-logo.avif" width="34" height="34" alt="886 Studios" /></a>
    </nav>
  </header>

  <div class="directory-main residency-perks-page">
    <header class="residency-perks-title"><h1>886 Residency perks</h1></header>
    <section class="directory" aria-label="Partner perks">
      <form class="filter-form" role="search" hidden>
        <div class="search-row">
          <div class="search-field">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6" /><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
            <label class="sr-only" for="perk-search">Search partners or perks</label>
            <input id="perk-search" name="q" type="search" placeholder="Search partners or perks" autocomplete="off" />
          </div>
          <fieldset class="sort-toggle">
            <legend class="sr-only">Sort by</legend>
            <label class="sort-option"><input type="radio" name="sort" value="category" aria-label="Category" /><span>Category</span></label>
            <label class="sort-option"><input type="radio" name="sort" value="alphabetical" aria-label="Alphabetical (A–Z)" checked /><span>A–Z</span></label>
          </fieldset>
        </div>
        <div class="filters" role="group" aria-label="Filter by type">
          {["", ...residencyPerkCategories.map(category => category.title)].map((category) => (
            <button type="button" class:list={["filter", !category && "is-active"]} aria-pressed={!category} data-filter={category}>{category || "All perks"}</button>
          ))}
        </div>
        <p class="result-count" id="result-count" role="status" aria-live="polite">{perks.length} partners</p>
      </form>
      <div class="list-header" aria-hidden="true"><span>Partner</span><span>Type</span><span>Perk</span></div>
      <div class="perk-list">
        {perks.map((perk, index) => (
          <article data-perk-id={perk.id} data-category={perk.category} data-category-order={perk.categoryIndex} data-name-order={index} data-search={[perk.label, perk.category, perk.benefit, ...perk.eligibility].join(" ").toLowerCase()} aria-labelledby={`perk-${perk.id}`}>
            <details class="perk-row" id={perk.id}>
              <summary>
                <span class="partner">
                  <span class="partner-logo" aria-hidden="true">
                    {perk.logoSrc ? <img src={perk.logoSrc} alt="" width="40" height="40" loading="lazy" decoding="async" /> : <span class="wordmark wordmark-beyond-border">BB</span>}
                  </span>
                  <span class="partner-name" id={`perk-${perk.id}`}>{perk.label}</span>
                </span>
                <span class="perk-type"><span class="mobile-field-label">Type</span><span>{perk.category}</span></span>
                <span class="benefit"><span class="benefit-title">{perk.benefit}</span></span>
                <span class="view-perk"><span class="closed-label">Details</span><span class="open-label">Close</span><svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
              </summary>
              <div class="perk-detail">
                <div class="detail-offer"><h2>Perk</h2><p>{perk.benefit}</p></div>
                <div class="detail-eligibility"><h2>Eligibility</h2><ul>{perk.eligibility.map(condition => <li>{condition}</li>)}</ul></div>
                <div class="detail-redemption">
                  <div class="redemption-actions">
                    <a class="button button-primary redeem-link" href={perk.applicationHref ?? residencyPerkRequestHref(perk.label)} aria-label={perk.applicationHref ? `Apply to ${perk.label}` : `Request ${perk.label} access`}>{perk.applicationHref ? "Apply" : "Request access"} <span aria-hidden="true">↗</span></a>
                    <div class="secondary-links"><a href={perk.href} target="_blank" rel="noopener noreferrer">Program details <span aria-hidden="true">↗</span><span class="sr-only"> for {perk.label} (opens in a new tab)</span></a></div>
                  </div>
                </div>
              </div>
            </details>
          </article>
        ))}
      </div>
      <div class="empty-state" hidden><h2>No perks found.</h2><button class="button button-subtle" type="button" data-reset>Clear filters</button></div>
    </section>
    <footer class="directory-footer"><a class="residency-perks-back" href="/residency">← 886 Residency</a></footer>
  </div>
  <script>
    import "../scripts/residency-perks";
  </script>
</BaseLayout>
