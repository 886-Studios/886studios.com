---
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import LinkedInInsight from "../components/LinkedInInsight.astro";
import { applicationUrl, getGoogleAnalyticsId, siteConfig } from "../config/site";

const googleAnalyticsId = getGoogleAnalyticsId();
---

<html lang="en">
  <head>
    <GoogleAnalytics measurementId={googleAnalyticsId} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0;url=${applicationUrl}`} />
    <title>{`Apply | ${siteConfig.name}`}</title>
  </head>
  <body>
    <script>
      import { applicationUrl } from "../config/site";
      window.location.replace(applicationUrl);
    </script>
    <main>
      <p>Redirecting to application form... <a href={applicationUrl}>Click here</a> if not redirected.</p>
    </main>
    <LinkedInInsight />
  </body>
</html>
