---
import ApplicationGuidePage from "../../components/pages/ApplicationGuidePage.astro";
import ResourceArticlePage from "../../components/pages/ResourceArticlePage.astro";
import { contentDates } from "../../data/contentDates.generated";
import { resourceArticles } from "../../data/resourceArticles";
import type { ResourceArticle } from "../../data/resourceArticles";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getResourceArticleSchema,
  getResourceDescription,
  getResourceFaqSchema,
  getResourcePageTitle,
} from "../../lib/seo";

export function getStaticPaths() {
  return resourceArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props as { article: ResourceArticle };
const pagePath = `/resources/${article.slug}`;
const dateModified = contentDates[pagePath];
const faqSchema = getResourceFaqSchema(article, pagePath);
---

<BaseLayout
  title={getResourcePageTitle(article)}
  description={getResourceDescription(article)}
  dateModified={dateModified}
  ogType="article"
  breadcrumbs={[
    { name: "Resources", path: "/resources" },
    ...(article.parent ? [{ name: article.parent.label, path: article.parent.href }] : []),
    { name: article.title, path: pagePath },
  ]}
  structuredData={[
    getResourceArticleSchema(article, pagePath, dateModified),
    ...(faqSchema ? [faqSchema] : []),
  ]}
>
  {article.slug === "application-guide" ? <ApplicationGuidePage /> : <ResourceArticlePage article={article} />}
</BaseLayout>
