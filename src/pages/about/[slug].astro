---
import RedirectLayout from "../../layouts/RedirectLayout.astro";
import { partnerProfiles } from "../../data/partnerProfiles";

export function getStaticPaths() {
  return partnerProfiles.map((profile) => ({
    params: { slug: profile.legacySlug },
    props: { destination: `/team/${profile.slug}` },
  }));
}

const { destination } = Astro.props;
---

<RedirectLayout
  destination={destination}
  title="Profile has moved"
  label="Continue to profile"
  linkId="profile-destination"
/>
