---
import GoogleAnalytics from "../../components/GoogleAnalytics.astro";
import LinkedInInsight from "../../components/LinkedInInsight.astro";
import VercelAnalytics from "../../components/VercelAnalytics.astro";
import { getGoogleAnalyticsId, siteConfig } from "../../config/site";
import { partnerProfiles } from "../../data/partnerProfiles";

export function getStaticPaths() {
  return partnerProfiles.map((profile) => ({
    params: { slug: profile.legacySlug },
    props: { destination: `/team/${profile.slug}` },
  }));
}

const { destination } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={`${siteConfig.url}${destination}`} />
    <title>Profile has moved | 886 Studios</title>
    <GoogleAnalytics measurementId={getGoogleAnalyticsId()} />
  </head>
  <body>
    <main><p><a id="profile-destination" href={destination}>Continue to profile</a></p></main>
    <script>
      const destination = document.querySelector<HTMLAnchorElement>("#profile-destination")?.getAttribute("href");
      if (destination) window.location.replace(`${destination}${window.location.search}${window.location.hash}`);
    </script>
    <VercelAnalytics />
    <LinkedInInsight />
  </body>
</html>
