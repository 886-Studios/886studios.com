{
  "name": "886studios-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "predev": "npm run content-dates:generate",
    "dev": "astro dev",
    "content-dates:generate": "node scripts/generate-content-dates.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "prebuild": "npm run content-dates:generate && npm run images:optimize",
    "build": "astro build",
    "preview": "astro preview",
    "precheck": "npm run content-dates:generate",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:built": "node --test tests/built/*.test.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:security": "node scripts/check-security.mjs",
    "events:sync": "node scripts/sync-luma-events.mjs",
    "events:sync:dry-run": "node scripts/sync-luma-events.mjs --dry-run",
    "validate:code": "npm run check && npm run test",
    "validate": "npm run validate:code && npm run build && npm run test:built && npm run check:seo && npm run check:security",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "indexnow:dry-run": "node scripts/submit-indexnow.mjs --dry-run"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "astro": "^7.4.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "fast-xml-parser": "^5.10.1",
    "sanitize-html": "^2.18.1"
  },
  "overrides": {
    "yaml": "2.8.3"
  }
}
